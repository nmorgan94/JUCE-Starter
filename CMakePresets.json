{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with symbols",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with optimizations",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug Build",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "unit",
      "displayName": "Unit Tests Build",
      "description": "Build the Catch2 unit tests (and the plugin code they link)",
      "configurePreset": "debug",
      "configuration": "Debug",
      "targets": ["unit_tests"]
    },
    {
      "name": "test",
      "displayName": "All Tests Build",
      "description": "Build the plugin, pluginval and the unit tests",
      "configurePreset": "debug",
      "configuration": "Debug",
      "targets": ["all_tests"]
    },
    {
      "name": "test-release",
      "displayName": "All Tests Build (Release)",
      "description": "Build the Release plugin, pluginval and the unit tests",
      "configurePreset": "release",
      "configuration": "Release",
      "targets": ["all_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 0
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Tests",
      "description": "Run the unit tests and pluginval against the Debug build",
      "inherits": "test-base",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "unit",
      "displayName": "Unit Tests",
      "description": "Run only the Catch2 unit tests against the Debug build (skips pluginval)",
      "inherits": "test-base",
      "configurePreset": "debug",
      "configuration": "Debug",
      "filter": {
        "include": {
          "name": "\\.unit\\."
        }
      }
    },
    {
      "name": "release",
      "displayName": "Release Tests",
      "description": "Run the unit tests and pluginval against the Release build",
      "inherits": "test-base",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ]
}
