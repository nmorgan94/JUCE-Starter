# Copy to .env, fill in, and `source .env` before configuring.
# The licence signing keys the plugin trusts: <keyId>:<publicKeyHex>, comma separated.
export LICENCE_KEYS=
# The page the Activate button opens, as https://example.com/activate. Only needed with PLUGIN_REQUIRE_ACTIVATION.
export ACTIVATION_URL=
# The plugin's page on the website, as https://example.com/plugins/example. Unset, the plugin never asks for updates.
export UPDATE_URL=
